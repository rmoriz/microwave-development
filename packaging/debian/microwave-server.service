[Unit]
Description=Microwave Server (Chef Infra Server API-compatible)
Documentation=https://github.com/rmoriz/microwave-development
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=microwave
Group=microwave

# The package installs /etc/microwave/microwave.toml as a conffile with mode
# 0640 root:microwave. Edit it and restart the unit; environment overrides
# belong in a drop-in such as /etc/systemd/system/microwave-server.service.d/.
ExecStartPre=/usr/bin/microwave-ctl --config /etc/microwave/microwave.toml check-config
ExecStart=/usr/bin/microwave-server serve --config /etc/microwave/microwave.toml
# The process logs to stderr. Send that to a file inside the log directory that
# systemd creates and owns (LogsDirectory= below), rotated by logrotate with
# copytruncate: the server has no log-reopen signal, SIGHUP reloads TLS only.
StandardOutput=append:/var/log/microwave/microwave.log
StandardError=inherit
# SIGHUP reloads the TLS certificate/key pair when the TLS listener is enabled.
# With plain HTTP it logs that there is nothing to reload and continues, so
# `systemctl reload` is always safe. It does not re-read the rest of the
# configuration; restart for that.
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# systemd creates and owns these. Leave them to systemd; drop-ins should not
# repoint them. The binary itself only writes below the data directory. systemd
# would create the log file root-owned when it opens the append target, so the
# package pre-creates it 0600 microwave:microwave (postinst) and keeps that
# stable; rotation runs as root either way.
StateDirectory=microwave
StateDirectoryMode=0700
LogsDirectory=microwave
LogsDirectoryMode=0750
ConfigurationDirectory=microwave
ConfigurationDirectoryMode=0755

Environment=RUST_LOG=info
UMask=0077
LimitNOFILE=65536

# Hardening. The server does not need privileges, a writable home, or access
# to anything outside its data directory. If the listener is changed to a
# privileged port (<1024), add:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/microwave

[Install]
WantedBy=multi-user.target
