#!/bin/sh
# Refresh systemd after the unit has been removed. Only a purge removes
# mutable state; a plain remove keeps /var/lib/microwave and the service log so
# a reinstall can pick up the existing database and keep appending.
set -e

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
fi

if [ "$1" = "purge" ]; then
    # A purge drops the mutable state as well, including the service log and
    # its rotation state.
    rm -rf /var/lib/microwave
    rm -rf /var/log/microwave
    rm -rf /etc/microwave

    if getent passwd microwave >/dev/null 2>&1; then
        deluser --system microwave >/dev/null 2>&1 || true
    fi
    if getent group microwave >/dev/null 2>&1; then
        delgroup --system microwave >/dev/null 2>&1 || true
    fi
fi

exit 0
