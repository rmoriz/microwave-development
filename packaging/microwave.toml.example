# Microwave Server configuration.
#
# Precedence (lowest to highest):
#   1. built-in defaults
#   2. this file (`--config`, `MW_CONFIG`, or ./microwave.toml)
#   3. MW_* environment variables
#
# The file is valid TOML with the local single-node defaults active. External
# backends are shown as commented alternatives; uncomment one block per
# section and keep exactly one active value per key.
#
# Verify a file before starting the server:
#   microwave-ctl --config /etc/microwave/microwave.toml check-config
#   microwave-server config --config /etc/microwave/microwave.toml

[server]
# Address the listener binds to. Plain HTTP is the default; enable the TLS
# section below to serve HTTPS directly. A TLS-terminating reverse proxy in
# front of plain HTTP remains supported.
bind = "0.0.0.0:8000"
# 0 lets the server size the Tokio runtime from the available CPUs.
worker_threads = 0
# Public origin clients use to reach this server, for example
# "https://chef.example.com". Required when [mail] is enabled so password-reset
# links are built from a trusted value instead of the unauthenticated Host
# header. Must be an absolute origin with no credentials, path, query, or
# fragment. https is required except for loopback development addresses
# (localhost, 127.0.0.1, ::1), which may use http.
# public_url = "https://chef.example.com"

# Optional TLS listener (rustls). Setting either path enables HTTPS; the other
# is then required and the pair is validated. `enabled = true` makes that
# explicit and `enabled = false` keeps plain HTTP even when paths are present.
# [server.tls]
# enabled = true
# cert_path = "/etc/microwave/tls.crt"   # PEM certificate chain
# key_path = "/etc/microwave/tls.key"    # PEM private key, mode 0600
# Periodic reload in seconds; 0 disables polling. SIGHUP reloads immediately
# on Unix. The timer only reloads when the files changed, and a failed reload
# keeps the previous certificate. Maximum 604800.
# reload_interval_seconds = 0
#
# The certificate must be valid for the names clients use; for chef-client
# that is the server URL hostname. `check-config` verifies readability, PEM
# structure, and that the key matches the certificate. Intermediate
# certificates belong in cert_path, above the leaf certificate. Replace both
# files atomically and send SIGHUP (or enable reload_interval_seconds) to
# rotate them without a restart.

[paths]
# All mutable local state lives here: microwave.db (+ WAL/SHM), bookshelf/
# blobs for the local object-store backend, pivotal.pem, pivotal.password and
# objectstore.secret. The systemd unit and container image both use this path.
data_dir = "/var/lib/microwave"

[database]
# `sqlite` (default) or `postgres`. The HTTP server supports both; the
# microwave-ctl/microwave-migrate tools and the local backup path require
# SQLite.
driver = "sqlite"
# Defaults to sqlite://<paths.data_dir>/microwave.db when omitted.
# url = "sqlite:///var/lib/microwave/microwave.db"
# PostgreSQL example:
# driver = "postgres"
# url = "postgres://microwave:secret@db/microwave"

[storage]
# Compression for new `serialized_object` writes: "zlib" (default) stores
# `mwz1:` + base64(zlib(JSON)); "none" stores plain JSON for easier database
# inspection. Either setting reads both forms, so switching does not require a
# rewrite and existing databases keep working.
compression = "zlib"

[search]
# `embedded` reads the relational store directly and needs no extra service.
backend = "embedded"
# --- OpenSearch / Elasticsearch (HA profiles) -----------------------------
# backend = "opensearch"
# url = "http://opensearch:9200"
# Request timeout in milliseconds for remote `_bulk`, `_delete_by_query`, and
# `_refresh` calls. Must be greater than zero.
# timeout_ms = 30000
# The backend writes to the `chef` index and sends the organization and
# object-type constraints as a filter query, matching upstream.
#
# Switching a populated installation from `embedded` to a remote backend does
# not backfill documents automatically. Run `microwave-ctl reindex` to rebuild
# them from the relational store. The default reindex adds or replaces
# documents by id and leaves documents for deleted objects in place; pass
# `--purge` to delete each organization's existing remote documents first.
# `--purge` is destructive: an interrupted run can leave the organization
# unsearchable until the reindex is run again. Run reindex during a maintenance
# window.

[object_store]
# `local` serves /bookshelf from <data_dir>/bookshelf.
backend = "local"
# Shared secret for local /bookshelf tokens. Generated on first start into
# <data_dir>/objectstore.secret and copied into the metadata secrets table.
# secret = "replace-with-a-long-random-string"

# --- S3 / Garage ----------------------------------------------------------
# backend = "garage"            # or "s3"
# endpoint = "http://host.docker.internal:3900"
# bucket = "chef-cookbooks"
# region = "garage"
# path_style = true             # required for Garage, MinIO, and most S3 gateways
# access_key = "GK..."
# secret_key = "..."
#
# The endpoint is used for two different purposes: server-side PUT/HEAD/GET/
# DELETE calls *and* for the presigned URLs handed to chef-client. It must
# therefore resolve and be reachable from both the server and the clients. For
# a real deployment use one DNS name behind a reverse proxy, not a Docker
# network alias such as `garage`.
#
# When access_key/secret_key are omitted the server falls back to the
# `bookshelf.access_key_id` / `bookshelf.secret_access_key` secrets stored in
# the metadata database:
#   microwave-ctl set-secret bookshelf access_key_id GK...
#   microwave-ctl set-secret bookshelf secret_access_key ...

[auth]
# Allowed clock skew for X-Ops-Timestamp, in seconds (upstream default 900).
# Increase only when client clocks cannot be kept in sync.
skew_seconds = 900
# The bootstrap superuser created on first start. The CLI and HTTP surfaces
# use `users.admin` for server-admin privileges; this name identifies the
# account that cannot be demoted.
superuser_name = "pivotal"
# Development only: include the password-reset URL in the HTTP response. Off by
# default. Enabling it lets any unauthenticated caller obtain a usable reset
# link for an existing account and is unsafe for production, even with mail
# enabled.
# password_reset_token_in_response = false
# Lifetime of password-reset tokens in seconds. Default 3600, maximum 604800
# (seven days); must be greater than zero. The reset email derives its expiry
# text from this value.
# password_reset_ttl_seconds = 3600

# Outbound SMTP for password-reset mail. Disabled by default; all other keys in
# this section are ignored while `enabled` is false or `host` is empty. Setting
# mail.enabled = true requires server.public_url, host, and from, and an invalid
# enabled configuration fails startup (and `check-config`) instead of failing at
# the first reset request. Remote authenticated SMTP is the supported production
# path; use starttls or tls.
# [mail]
# enabled = false
# Relay hostname. Required when mail is enabled.
# host = "smtp.example.com"
# Port. Defaults to 587 for starttls, 465 for tls (implicit TLS/SMTPS), and 25
# for plaintext when omitted.
# port = 587
# starttls (default) upgrades the connection on port 587, tls uses implicit TLS
# on port 465, and none is explicit plaintext for a trusted local relay on port
# 25. SMTP AUTH with none is accepted only for loopback hosts; a remote relay
# with credentials must use starttls or tls.
# security = "starttls"
# SMTP AUTH credentials. username requires password and vice versa.
# username = "chef-mailer"
# Prefer MW_MAIL__PASSWORD over storing the password in this file. It is
# redacted from logs and Debug output and is never serialized, so it is absent
# from microwave-config.json backups; provide it again after a restore.
# password = "secret"
# auto (default) lets the transport negotiate AUTH; plain and login force a
# mechanism. auto, plain, and login all require username and password. Set none
# for an unauthenticated relay, and do not combine it with credentials.
# auth = "auto"
# From header. Required when mail is enabled; a display name is accepted.
# from = "Chef Infra Server <chef@example.com>"
# Optional Reply-To header.
# reply_to = "ops@example.com"
# SMTP timeout in milliseconds. Must be greater than zero.
# timeout_ms = 10000
# EHLO/HELO name. When unset the mail library's default is used.
# hello_name = "chef.example.com"
# Optional extra PEM CA certificate used to verify a relay with a private CA.
# System roots remain trusted. The file is read when the mailer is built at
# startup; an unreadable or unparseable file fails startup.
# tls_ca_path = "/etc/ssl/private-ca.pem"

[keygen]
# API key creation takes pre-generated 2048-bit RSA keypairs from this bounded
# in-memory cache so `create_key`, client/user creation, and organization
# validator provisioning do not block on RSA generation.
#
# Maximum number of ready keypairs (0-1024). 0 disables caching and generates
# on demand.
size = 3
# Background generator threads (0-8), and never more than `size`. 0 leaves
# refilling to warm_up and on-demand generation.
workers = 1
# Fill the cache synchronously at startup. Requires size > 0. The default keeps
# startup fast and lets workers fill the cache in the background.
warm_up = false

[data_collector]
# Setting root_url enables POST /organizations/:org/data-collector and forwards
# the JSON payload to Automate or another collector. Leave unset to disable the
# endpoint (it then returns 404, which chef-client treats as normal).
# root_url = "https://automate.example.com/data-collector/v0/"
# Shared token accepted from clients and sent upstream. It may also be stored
# as the `data_collector.token` secret with:
#   microwave-ctl set-secret data_collector token <token>
# token = "replace-with-a-long-random-token"
# Forwarding timeout in milliseconds (upstream default 30000). `timeout_ms` is
# accepted as an alias.
timeout = 30000
# Emit server-side mutation notifications (`oc_chef_action`) for successful
# writes while the collector is configured. This is opt-in: root_url alone
# only enables client payload forwarding. Notifications use a bounded
# in-process queue and never delay the API response.
actions_enabled = false
# Hostname reported as `service_hostname` in action messages. When unset the
# request X-Forwarded-Host (or Host) is used.
# service_hostname = "chef.example.com"

[compliance_proxy]
# Enables the Automate compliance profile proxy:
#   GET /organizations/:org/owners/:owner/compliance[/profile]
#   GET /compliance/organizations/:org/owners/:owner/compliance[/profile]
# Both are rewritten to /compliance/profiles/:owner[/profile] upstream.
# Leave unset to disable the routes (they then return 404).
# url = "https://automate.example.com"
# Optional service token. When omitted the data_collector.token (or its
# secret) is used, matching upstream nginx.
# token = "replace-with-a-long-random-token"
# Header that carries the token. Defaults to x-data-collector-token.
# token_header = "x-data-collector-token"
# Forwarding timeout in milliseconds (upstream default 30000). `timeout_ms` is
# accepted as an alias.
timeout = 30000
# Skip TLS certificate verification for the compliance upstream. Keep false in
# production; enable only for a test stub or a trusted private CA setup that
# requires it.
insecure_skip_tls_verify = false

[required_recipe]
# Serve a server-enforced recipe at GET /organizations/:org/required_recipe.
# The endpoint is absent (404 for every method) while disabled.
enabled = false
# path = "/etc/microwave/required_recipe.rb"

[telemetry]
# Reserved for compatibility. Microwave never phones home: telemetry is
# disabled by default and no outbound sender is implemented.
enabled = false
# reporting_url = "https://telemetry.example.com/ingest"
interval_seconds = 86400
