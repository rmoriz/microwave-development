[Unit]
Description=Stage the knife config from the seed hand-over
Documentation=file:/shared/seed-summary.txt
Wants=network-online.target
After=network-online.target network.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Run as root: the seed hand-over files are root-owned 0600, and systemd needs
# a root PID 1.
Type=oneshot
RemainAfterExit=yes
# systemd system units have no HOME; knife loads plugins that join it.
Environment=HOME=/home/dev
Environment=KNIFE_HOME=/home/dev/.chef
# /tmp is a tmpfs; be explicit because systemd services get a clean env.
Environment=TMPDIR=/tmp
# Pass the image/compose token into the unit environment. systemd services get
# a clean environment, and OpenCode's `{env:MW_MCP_TOKEN}` header substitution
# reads the background service's environment.
PassEnvironment=MW_MCP_TOKEN
ExecStart=/usr/local/bin/workstation-prepare
StandardOutput=journal+console
StandardError=journal+console
# The script is idempotent; retry transient failures (the API restarting, a
# dropped DNS lookup) instead of leaving the box half-prepared.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
