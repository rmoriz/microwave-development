[Unit]
Description=Converge with Cinc Client against microwave-server
Documentation=file:/shared/seed-summary.txt
Wants=network-online.target
After=network-online.target network.target

[Service]
Type=oneshot
# systemd starts services with a clean environment, so the node name from the
# container environment (compose `environment:`) has to be passed explicitly.
PassEnvironment=NODE_NAME
RemainAfterExit=yes
# A large run (cookbook download plus compile) must not be killed by the
# default start timeout.
TimeoutStartSec=0
ExecStart=/usr/local/bin/cinc-e2e-converge
StandardOutput=journal+console
StandardError=journal+console
