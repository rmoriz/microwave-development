metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret_file = "/etc/microwave/garage.rpc_secret"

# The engine only listens on loopback; nginx terminates TLS in front of it.
[s3_api]
api_bind_addr = "127.0.0.1:3910"
s3_region = "<%= @region %>"
public_endpoint = "https://<%= @hostname %>:<%= @port %>"
public_endpoint_path_style = true

[admin]
api_bind_addr = "127.0.0.1:3903"
admin_token_file = "/etc/microwave/garage.admin_token"
