<% toml = ->(value) { value.to_s.gsub('\\') { '\\\\' }.gsub('"') { '\\"' }.gsub("\n") { '\\n' }.gsub("\t") { '\\t' }.gsub("\r") { '\\r' } } -%>
[server]
bind = "<%= toml.(@bind) %>"
<% if @public_url -%>
public_url = "<%= toml.(@public_url) %>"
<% end -%>

[paths]
data_dir = "/var/lib/microwave"

[object_store]
backend = "local"

[database]
driver = "postgres"
url = "<%= toml.(@database_url) %>"

[search]
backend = "opensearch"
url = "<%= toml.(@search_url) %>"
