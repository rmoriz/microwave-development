# TLS in front of Garage. The engine itself only listens on loopback; this
# block is the only public way in, so the Microwave client speaks HTTPS on 3900.
server {
  listen <%= @hostname %>:<%= @port %> ssl;
  # The server on this node reaches the store over loopback.
  listen 127.0.0.1:<%= @port %> ssl;
  server_name <%= @hostname %>;

  ssl_certificate <%= @cert %>;
  ssl_certificate_key <%= @key %>;
  ssl_protocols TLSv1.2 TLSv1.3;

  # Uploads stream straight through instead of spooling to disk first.
  client_max_body_size 0;
  proxy_request_buffering off;
  proxy_read_timeout 300s;
  proxy_send_timeout 300s;

  access_log /var/log/nginx/microwave-garage.access.log;
<% if @client_network -%>

  # Garage has no network rules of its own, so nginx narrows the listener.
  allow <%= @client_network %>;
  allow 127.0.0.1;
  allow ::1;
  deny all;
<% end -%>

  location / {
    proxy_pass http://127.0.0.1:<%= @upstream %>;
    # The SigV4 signature covers the authority including the port, so the
    # request host has to arrive verbatim: $host would drop the port and every
    # request would answer SignatureDoesNotMatch.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
