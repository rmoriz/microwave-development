---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
import Footer from '../components/Footer.astro';
import GridField from '../components/GridField.astro';
import { BASE_PATH, SITE_URL } from '../data/config';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
import { getRelativeLocaleUrlList } from 'astro:i18n';

interface Props {
  title: string;
  description: string;
  /** Absolute URL or an already base-prefixed path. */
  image?: string;
  noindex?: boolean;
  preload?: {
    href: string;
    srcset: string;
    sizes: string;
    type: string;
  };
}

const {
  title,
  description,
  image = withBase('/og.png'),
  noindex = false,
  preload,
} = Astro.props;
const origin = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, origin);
const socialImage = new URL(withBase(image), origin);
const stripBase = (p: string) => (p.startsWith(BASE_PATH) ? p.slice(BASE_PATH.length) || '/' : p);
const localeUrls = getRelativeLocaleUrlList(stripBase(Astro.url.pathname));
const localeCodes = ['en', 'de', 'fr', 'it', 'es', 'nl'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description,
  url: canonical.href,
  license: site.license,
  codeRepository: site.github,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Docker',
  isAccessibleForFree: true,
};
---
<!doctype html>
<html lang={Astro.currentLocale ?? 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-XSS-Protection" content="1" />
    <meta http-equiv="Referrer-Policy" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="theme-color" content="#2a4d6e" />
    <link rel="canonical" href={canonical} />
    {localeUrls.map((href, index) => (
      <link rel="alternate" hreflang={localeCodes[index]} href={new URL(href, origin)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localeUrls[0], origin)} />
    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
        type={preload.type}
      />
    )}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Microwave Server — Get cooking without becoming a chef." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <GridField />
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      try {
        const reveals = Array.from(
          document.querySelectorAll<HTMLElement>('.reveal'),
        );
        const reduceMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;

        if (reduceMotion || !('IntersectionObserver' in window)) {
          reveals.forEach((element) => element.classList.add('is-visible'));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              }
            },
            { rootMargin: '0px 0px -10% 0px' },
          );
          reveals.forEach((element) => observer.observe(element));
        }
      } catch {
        // Content is visible by default; animation is optional.
      }
    </script>
  </body>
</html>
