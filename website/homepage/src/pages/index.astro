---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import CincSection from '../components/CincSection.astro';
import Compatibility from '../components/Compatibility.astro';
import UnderTheHood from '../components/UnderTheHood.astro';
import KnownGaps from '../components/KnownGaps.astro';
import Migration from '../components/Migration.astro';
import Support from '../components/Support.astro';
import FAQ from '../components/FAQ.astro';
import { site } from '../data/site';
---
<Base title={site.title} description={site.description}>
  <Nav slot="header" />
  <Hero />
  <ProofStrip />
  <CincSection />
  <Compatibility />
  <UnderTheHood />
  <KnownGaps />
  <Migration />
  <Support />
  <FAQ />
</Base>
