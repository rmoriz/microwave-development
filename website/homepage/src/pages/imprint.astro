---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { withBase } from '../lib/paths';
import { site } from '../data/site';

const operator = site.legal.operator || '[to be supplied]';
const address = site.legal.address || '[to be supplied]';
const needsCompletion = !site.legal.operator || !site.legal.address;
---
<Base
  title="Imprint — Microwave Server"
  description="Operator and contact details for microwave.io."
>
  <Nav slot="header" />
  <section class="legal-page">
    <div class="container legal-inner">
      <p class="eyebrow">Imprint</p>
      <h1>Imprint</h1>
      <p>Responsible for this site:</p>
      <address>
        {operator}<br />
        {address}<br />
        <a href={`mailto:${site.legal.email}`}>{site.legal.email}</a>
      </address>
      {needsCompletion && (
        <p class="legal-warning">This page must be completed before launch.</p>
      )}
      <a class="text-link" href={withBase('/')}>Back to home <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>
