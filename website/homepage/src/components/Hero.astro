---
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import heroImage from '../assets/microwave-hero.png';
---
<section class="hero reveal">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Independent · Open source · Rust · Agent-ready</p>
      <h1>Get cooking <span class="hero-accent">without becoming a chef.</span></h1>
      <p class="hero-sub">
        Microwave is an independent, open-source Chef Infra Server API
        implementation written in Rust. Keep your cookbooks, clients, and CLI.
        Run a simpler server, with the backing services you already trust.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={site.docs}>Read the docs</a>
        <a class="button button-ghost" href={site.runFromSource}>Run it from source</a>
      </div>
      <ul class="badge-row" aria-label="Compatibility and license">
        <li class="badge">Cinc Client 19</li>
        <li class="badge">Chef Infra Client 18/19</li>
        <li class="badge">Experimental MCP for AI agents</li>
        <li class="badge">AGPL-3.0</li>
      </ul>
    </div>

    <figure class="hero-figure">
      <button
        class="hero-egg"
        type="button"
        data-hero-egg
        aria-label="Play the hidden microwave video"
      >
        <Picture
          src={heroImage}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1536]}
          sizes="(min-width: 900px) 46vw, 100vw"
          alt="A rainbow neon microwave glowing on a dark surface"
          loading="eager"
          fetchpriority="high"
        />
      </button>
      <div class="hero-video" data-hero-video hidden></div>
      <figcaption data-hero-caption>Artist's impression. The real thing is a single binary.</figcaption>
    </figure>
  </div>
</section>

<script>
  declare global {
    interface Window {
      YT?: {
        Player: new (element: HTMLElement, options: unknown) => YtPlayer;
      };
      onYouTubeIframeAPIReady?: () => void;
    }
    interface YtPlayer {
      playVideo: () => void;
      getIframe?: () => HTMLIFrameElement;
    }
  }

  const egg = document.querySelector<HTMLButtonElement>('[data-hero-egg]');
  const video = document.querySelector<HTMLElement>('[data-hero-video]');
  const caption = document.querySelector<HTMLElement>('[data-hero-caption]');
  const videoId = 'IRfgG3BtVlQ';
  const startAt = 21;
  const endAt = 90;
  const safety = 120_000;

  if (egg && video && caption) {
    const originalCaption = caption.textContent ?? '';
    let taps = 0;
    let reset = 0;
    let hide = 0;
    let api: Promise<void> | null = null;
    let view: IntersectionObserver | null = null;

    const loadApi = () => {
      api ??= new Promise<void>((resolve, reject) => {
        const previous = window.onYouTubeIframeAPIReady;
        window.onYouTubeIframeAPIReady = () => {
          previous?.();
          resolve();
        };
        const script = document.createElement('script');
        script.src = 'https://www.youtube.com/iframe_api';
        script.addEventListener('error', () => reject(new Error('API')), {
          once: true,
        });
        document.head.append(script);
      });
      return api;
    };

    const revert = () => {
      window.clearTimeout(hide);
      view?.disconnect();
      view = null;
      video.replaceChildren();
      video.hidden = true;
      egg.hidden = false;
      caption.textContent = originalCaption;
      taps = 0;
      if (document.activeElement === document.body) {
        egg.focus({ preventScroll: true });
      }
    };

    /** Stop the sound and restore the image as soon as the player leaves the viewport. */
    const watchViewport = () => {
      if (!('IntersectionObserver' in window)) return;
      view?.disconnect();
      view = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.intersectionRatio === 0)) revert();
      });
      view.observe(video);
    };

    /** Fifth touch: the player is created and started inside this gesture. */
    const play = async () => {
      video.hidden = false;
      egg.hidden = true;
      caption.textContent = 'Now playing — Kernkraft 400.';
      hide = window.setTimeout(revert, safety);
      watchViewport();

      try {
        await loadApi();
        const mount = document.createElement('div');
        video.append(mount);
        new window.YT!.Player(mount, {
          videoId,
          width: '100%',
          height: '100%',
          host: 'https://www.youtube-nocookie.com',
          playerVars: {
            autoplay: 1,
            start: startAt,
            end: endAt,
            rel: 0,
            playsinline: 1,
          },
          events: {
            onReady: (event: { target: YtPlayer }) => {
              event.target.playVideo();
              event.target.getIframe?.().focus();
            },
            onStateChange: (event: { data: number }) => {
              if (event.data === 0) revert();
            },
          },
        });
      } catch {
        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&start=${startAt}&end=${endAt}&rel=0&playsinline=1`;
        frame.title = 'Zombie Nation – Kernkraft 400';
        frame.allow = 'autoplay; encrypted-media; picture-in-picture';
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.allowFullscreen = true;
        frame.addEventListener(
          'load',
          () => {
            frame.dataset.loaded = 'true';
            hide = window.setTimeout(revert, (endAt - startAt) * 1000);
          },
          { once: true },
        );
        video.replaceChildren(frame);
        frame.focus();
      }
    };

    egg.addEventListener('click', () => {
      taps += 1;
      window.clearTimeout(reset);
      if (taps < 5) {
        reset = window.setTimeout(() => {
          taps = 0;
        }, 2000);
        return;
      }
      void play();
    });
  }
</script>
