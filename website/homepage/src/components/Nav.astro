---
import { site } from '../data/site';
import { withBase } from '../lib/paths';
import Logo from './Logo.astro';

const links = [
  { href: withBase('/#product'), label: 'Product' },
  { href: withBase('/#agents'), label: 'Agents' },
  { href: withBase('/#compatibility'), label: 'Compatibility' },
  { href: withBase('/#under-the-hood'), label: 'Under the hood' },
  { href: withBase('/#support'), label: 'Support' },
  { href: withBase('/#faq'), label: 'FAQ' },
];
---
<header class="site-header">
  <div class="container nav-shell">
    <Logo />

    <nav class="nav-desktop" aria-label="Primary">
      <ul class="nav-links">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <a class="button button-small nav-download" href={site.releases}>Download</a>
      <a class="button button-primary button-small" href={site.docs}>Docs</a>
      <a class="nav-github" href={site.github}>GitHub</a>
    </div>

    <details class="nav-mobile">
      <summary aria-label="Open menu">Menu</summary>
      <nav aria-label="Mobile">
        <ul>
          {links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          <li><a href={site.releases}>Download</a></li>
          <li><a href={site.github}>GitHub</a></li>
          <li><a class="button button-primary" href={site.docs}>Docs</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
