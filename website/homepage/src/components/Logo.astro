---
import { site } from '../data/site';
---
<a class="logo" href="/" aria-label={`${site.name} home`}>
  <svg class="logo-mark" viewBox="0 0 34 34" aria-hidden="true">
    <defs>
      <linearGradient id="mw-logo-gradient" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ff3ea5" />
        <stop offset="0.35" stop-color="#ffe14d" />
        <stop offset="0.7" stop-color="#4dff9e" />
        <stop offset="1" stop-color="#3ddcff" />
      </linearGradient>
    </defs>
    <rect
      x="2"
      y="7"
      width="30"
      height="20"
      rx="5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    />
    <rect
      x="7"
      y="12"
      width="14"
      height="10"
      rx="2.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
    />
    <circle cx="26" cy="14" r="1.4" fill="currentColor" />
    <path
      d="M23 21h5"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    />
    <path
      d="M2 7h30"
      stroke="url(#mw-logo-gradient)"
      stroke-width="2"
      stroke-linecap="round"
    />
  </svg>
  <span class="logo-word">microwave</span>
</a>
