---
import { site } from '../data/site';

const groups = [
  {
    title: 'API',
    items: [
      'Organizations, users, clients, keys',
      'Nodes, roles, environments',
      'Data bags, cookbooks, policyfiles',
      'Search, ACLs, OAuth/identity',
      'Data collector, compliance proxy',
      'Per-organization MCP endpoint',
    ],
  },
  {
    title: 'Auth',
    items: [
      'X-Ops-Sign 1.0/1.1/1.3 canonicalization',
      'RSA signing and verification',
      'Key reassembly',
      'Legacy password hashes',
      'Recursive ACL and group checks',
      'Default organization policy',
    ],
  },
  {
    title: 'Tooling',
    items: [
      'knife workflows',
      'chef-client and cinc-client',
      'microwave-ctl',
      'chef-server-ctl compatibility alias',
      'Docker, Compose, systemd',
      'MCP-capable AI agents',
    ],
  },
];
---
<section id="compatibility" class="section compatibility-section reveal">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Compatibility</p>
      <h2>Same recipe. New kitchen.</h2>
      <p>
        Your cookbooks and pipelines should not need a rewrite. Microwave
        implements the Chef Infra Server API surface that clients and operators
        already use, then lets you choose the runtime underneath it.
      </p>
    </div>

    <div class="compat-grid">
      {groups.map((group) => (
        <article class="compat-card">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <p class="compat-note">
      API parity is a moving target. The README's
      <a href={`${site.github}#http-route-parity`}>HTTP route parity</a> section and
      the <a href={`${site.github}/blob/main/docs/pedant-extended-report.md`}>Pedant reports</a>
      are the source of truth.
    </p>
  </div>
</section>
